# =============================================================================
# JabarNow! — Contoh environment variables
# Salin ke .env dan isi nilainya. JANGAN commit file .env yang berisi rahasia.
# =============================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://jabarnow.id

# --- Database (Supabase Postgres) ---
# DATABASE_URL = koneksi pooled (untuk runtime app)
# DIRECT_URL   = koneksi langsung (untuk migrasi Prisma)
DATABASE_URL=
DIRECT_URL=

# --- Auth.js (NextAuth v5) ---
# Generate AUTH_SECRET: `npx auth secret` atau `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=https://jabarnow.id

# --- Supabase (auth helper / service) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (storage media/foto, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Cron (publish terjadwal) ---
# Secret untuk endpoint /api/cron/publish-scheduled. Generate acak & rahasia.
# Panggil via crontab: curl -H "Authorization: Bearer <nilai ini>" ...
CRON_SECRET=

# --- Seed Super Admin (dipakai sekali oleh `npm run db:seed`) ---
# Jangan commit kredensial asli. Kosongkan untuk melewati pembuatan Super Admin.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# --- Opsional: integration-ready (colok nanti, aman jika kosong) ---
# GA4: isi untuk mengaktifkan Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Google Search Console: kode verifikasi meta tag
GSC_VERIFICATION=
